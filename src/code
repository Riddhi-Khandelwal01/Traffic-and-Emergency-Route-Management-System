/* ======================================================================
 *  MAIN SYSTEM
 * ====================================================================== */
class TrafficSystem {
    Graph graph;
    Vehicle *vHead, *vTail;
    Hospital *hHead, *hTail;
    Emergency *eHead, *eTail;
    EmergencyPQ pq;
    ActivityLog activity;
    int nextVehicleId, nextHospitalId, nextEmergencyId, nextSeq;

    TrafficSystem(const TrafficSystem&);
    TrafficSystem& operator=(const TrafficSystem&);

    /* ---------------------- record helpers ---------------------- */
    Vehicle* addVehicle(int type, int loc) {
        Vehicle* v = new Vehicle;
        v->id = nextVehicleId++;
        v->type = type;
        v->location = loc;
        v->available = true;
        v->next = NULL;
        if (!vHead) vHead = vTail = v; else { vTail->next = v; vTail = v; }
        return v;
    }

    Hospital* addHospital(const string& nm, int loc) {
        Hospital* h = new Hospital;
        h->id = nextHospitalId++;
        h->name = nm;
        h->location = loc;
        h->next = NULL;
        if (!hHead) hHead = hTail = h; else { hTail->next = h; hTail = h; }
        return h;
    }

    Emergency* addEmergency(int loc, int type, int sev) {
        Emergency* e = new Emergency;
        e->id = nextEmergencyId++;
        e->location = loc;
        e->locName = graph.name(loc);
        e->type = type;
        e->severity = sev;
        e->status = 0;
        e->vehicleId = -1;
        e->hospitalId = -1;
        e->seq = nextSeq++;
        e->next = NULL;
        if (!eHead) eHead = eTail = e; else { eTail->next = e; eTail = e; }
        PQItem it;
        it.id = e->id;
        it.severity = sev;
        it.seq = e->seq;
        pq.push(it);
        return e;
    }

    Vehicle* findVehicle(int id) const {
        for (Vehicle* v = vHead; v; v = v->next) if (v->id == id) return v;
        return NULL;
    }
    Hospital* findHospital(int id) const {
        for (Hospital* h = hHead; h; h = h->next) if (h->id == id) return h;
        return NULL;
    }
    Emergency* findEmergency(int id) const {
        for (Emergency* e = eHead; e; e = e->next) if (e->id == id) return e;
        return NULL;
    }

    bool removeVehicle(int id) {
        Vehicle *prev = NULL, *cur = vHead;
        while (cur && cur->id != id) { prev = cur; cur = cur->next; }
        if (!cur) return false;
        if (prev) prev->next = cur->next; else vHead = cur->next;
        if (cur == vTail) vTail = prev;
        delete cur;
        return true;
    }

    bool removeHospital(int id) {
        Hospital *prev = NULL, *cur = hHead;
        while (cur && cur->id != id) { prev = cur; cur = cur->next; }
        if (!cur) return false;
        if (prev) prev->next = cur->next; else hHead = cur->next;
        if (cur == hTail) hTail = prev;
        delete cur;
        return true;
    }

    int countVehicles(bool onlyAvailable) const {
        int c = 0;
        for (Vehicle* v = vHead; v; v = v->next) if (!onlyAvailable || v->available) c++;
        return c;
    }
    int countEmergencies(int status) const {
        int c = 0;
        for (Emergency* e = eHead; e; e = e->next) if (e->status == status) c++;
        return c;
    }
    int countHospitals() const {
        int c = 0;
        for (Hospital* h = hHead; h; h = h->next) c++;
        return c;
    }
    int countAllEmergencies() const {
        int c = 0;
        for (Emergency* e = eHead; e; e = e->next) c++;
        return c;
    }

    /* ---------------------- table printing ---------------------- */
    void vehicleHeader() const {
        cout << left << setw(5) << "ID" << setw(13) << "Type" << setw(24) << "Current Location"
             << "Status\n";
        printLine('-', 56);
    }
    void vehicleRow(const Vehicle* v) const {
        cout << left << setw(5) << v->id << setw(13) << vehicleTypeName(v->type)
             << setw(24) << fit(graph.name(v->location), 23)
             << (v->available ? "Available" : "ON MISSION") << "\n";
    }
    void hospitalHeader() const {
        cout << left << setw(5) << "ID" << setw(26) << "Hospital" << "Location\n";
        printLine('-', 56);
    }
    void hospitalRow(const Hospital* h) const {
        cout << left << setw(5) << h->id << setw(26) << fit(h->name, 25)
             << fit(graph.name(h->location), 24) << "\n";
    }
    void emergencyHeader() const {
