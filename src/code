    void menuSearch() {
        while (true) {
            printHeader("SEARCH RECORDS");
            cout << "  1. Find an emergency by ID            (binary search)\n"
                 << "  2. Find emergencies by location name  (linear search)\n"
                 << "  3. Find a vehicle by ID\n"
                 << "  4. Find a hospital by name\n"
                 << "  5. Find a location and its connecting roads\n"
                 << "  0. Back to main menu\n\n";
            int c = readInt("Enter your choice: ", 0, 5);
            if (c == 0) return;
            if (c == 1) {
                int n;
                Emergency** arr = emergencyArray(n);
                if (!arr) { cout << "\n  (No emergencies recorded yet.)\n"; continue; }
                int id = readInt("Enter the emergency ID: ", 1, 1000000);
                /* records are stored in increasing ID order, so binary search works */
                int lo = 0, hi = n - 1, pos = -1;
                while (lo <= hi) {
                    int mid = (lo + hi) / 2;
                    if (arr[mid]->id == id) { pos = mid; break; }
                    if (arr[mid]->id < id) lo = mid + 1; else hi = mid - 1;
                }
                if (pos == -1) cout << "  ! No emergency with ID " << id << " found.\n";
                else { cout << "\n"; emergencyHeader(); emergencyRow(arr[pos]); }
                delete[] arr;
            } else if (c == 2) {
                if (!eHead) { cout << "\n  (No emergencies recorded yet.)\n"; continue; }
                string key = readLine("Enter (part of) the location name: ");
                bool header = false;
                for (Emergency* e = eHead; e; e = e->next)
                    if (containsText(e->locName, key)) {
                        if (!header) { cout << "\n"; emergencyHeader(); header = true; }
                        emergencyRow(e);
                    }
                if (!header) cout << "  ! No emergency found at a location matching '" << key << "'.\n";
            } else if (c == 3) {
                if (!vHead) { cout << "\n  (No vehicles registered yet.)\n"; continue; }
                int id = readInt("Enter the vehicle ID: ", 1, 1000000);
                Vehicle* v = findVehicle(id);
                if (!v) cout << "  ! No vehicle with ID " << id << ".\n";
                else { cout << "\n"; vehicleHeader(); vehicleRow(v); }
            } else if (c == 4) {
                if (!hHead) { cout << "\n  (No hospitals registered yet.)\n"; continue; }
                string key = readLine("Enter (part of) the hospital name: ");
                bool header = false;
                for (Hospital* h = hHead; h; h = h->next)
                    if (containsText(h->name, key)) {
                        if (!header) { cout << "\n"; hospitalHeader(); header = true; }
                        hospitalRow(h);
                    }
                if (!header) cout << "  ! No hospital matching '" << key << "'.\n";
            } else {
                if (!needLocations(1)) continue;
                string key = readLine("Enter (part of) the location name: ");
                bool found = false;
                for (int i = 0; i < graph.size(); i++)
                    if (containsText(graph.name(i), key)) {
