const double INF             = 1e18;

template <typename T>
string toStr(T v) {
    ostringstream o;
    o << v;
    return o.str();
}

string toLower(const string& s) {
    string r = s;
    for (size_t i = 0; i < r.size(); i++) r[i] = (char)tolower((unsigned char)r[i]);
    return r;
}

string trim(const string& s) {
    size_t a = 0, b = s.size();
    while (a < b && isspace((unsigned char)s[a])) a++;
    while (b > a && isspace((unsigned char)s[b - 1])) b--;
    return s.substr(a, b - a);
}

bool containsText(const string& hay, const string& needle) {
    return toLower(hay).find(toLower(needle)) != string::npos;
}

/* cut a string so that it fits a column of width w */
string fit(const string& s, size_t w) {
    if (s.size() > w) return s.substr(0, w - 1) + ".";
    return s;
}

void printLine(char c = '=', int n = 78) {
    cout << string(n, c) << "\n";
}

void printHeader(const string& title) {
    cout << "\n";
    printLine('=');
    cout << "  " << title << "\n";
    printLine('=');
}

/* ----------------------------- Safe input ------------------------------ */
string readLine(const string& prompt) {
    string s;
    while (true) {
        cout << prompt;
        if (!getline(cin, s)) {
            cout << "\n[Input closed. Exiting the program.]\n";
            exit(0);
        }
        s = trim(s);
        if (!s.empty()) return s;
        cout << "  ! Input cannot be empty. Please try again.\n";
    }
}

int readInt(const string& prompt, int lo, int hi) {
    while (true) {
        string s = readLine(prompt);
        stringstream ss(s);
        int v;
        char extra;
        if ((ss >> v) && !(ss >> extra)) {
            if (v >= lo && v <= hi) return v;
        }
        cout << "  ! Invalid input. Enter a whole number between " << lo << " and " << hi << ".\n";
    }
}

double readDouble(const string& prompt, double lo, double hi) {
    while (true) {
        string s = readLine(prompt);
        stringstream ss(s);
        double v;
        char extra;
        if ((ss >> v) && !(ss >> extra)) {
            if (v >= lo && v <= hi) return v;
        }
        cout << "  ! Invalid input. Enter a number between " << lo << " and " << hi << ".\n";
    }
}

bool readYesNo(const string& prompt) {
    while (true) {
        string s = toLower(readLine(prompt));
        if (s == "y" || s == "yes") return true;
        if (s == "n" || s == "no") return false;
        cout << "  ! Please type y or n.\n";
    }
}

string readName(const string& prompt, size_t maxLen) {
    while (true) {
        string s = readLine(prompt);
        if (s.size() <= maxLen) return s;
        cout << "  ! Name too long (maximum " << maxLen << " characters). Try again.\n";
    }
}

