public:
    TrafficSystem()
        : vHead(NULL), vTail(NULL), hHead(NULL), hTail(NULL), eHead(NULL), eTail(NULL),
          nextVehicleId(1), nextHospitalId(1), nextEmergencyId(1), nextSeq(1) {}

    ~TrafficSystem() {
        while (vHead) { Vehicle* t = vHead->next; delete vHead; vHead = t; }
        while (hHead) { Hospital* t = hHead->next; delete hHead; hHead = t; }
        while (eHead) { Emergency* t = eHead->next; delete eHead; eHead = t; }
    }

    void run() {
        showBanner();
        if (readYesNo("\nLoad the built-in sample city (locations, roads, vehicles, hospitals)? (y/n): "))
            loadSampleData();
        else
            cout << "\n  Starting with an empty system. Begin with menu 1 to add locations and roads.\n";

        bool quit = false;
        while (!quit) {
            showDashboard();
            showMainMenu();
            int c = readInt("Enter your choice (0-13): ", 0, 13);
            switch (c) {
                case 1:  menuRoads(); clearScreen(); break;
                case 2:  menuTraffic(); clearScreen(); break;
                case 3:  registerEmergency(); pauseScreen(); clearScreen(); break;
                case 4:  menuVehicles(); clearScreen(); break;
                case 5:  menuHospitals(); clearScreen(); break;
                case 6:  findRoute(); pauseScreen(); clearScreen(); break;
                case 7:  dispatchNext(); pauseScreen(); clearScreen(); break;
                case 8:  viewPending(); pauseScreen(); clearScreen(); break;
                case 9:  menuEmergencyRecords(); clearScreen(); break;
                case 10: menuSearch(); clearScreen(); break;
                case 11: menuSort(); clearScreen(); break;
                case 12: printHeader("RECENT ACTIVITY LOG (queue)"); activity.display(); pauseScreen(); clearScreen(); break;
                case 13: showHelp(); pauseScreen(); clearScreen(); break;
                default:
                    if (readYesNo("\nAre you sure you want to exit? (y/n): "))
                    {
                        quit = true;
                        clearScreen();
                    }
                    else
                    {
                        clearScreen();
                    }
                    break;
            }
        }
        cout << "\n";
        printLine('=');
        cout << "  Thank you for using the Traffic & Emergency Route Management System.\n"
             << "  Drive safe, and make way for emergency vehicles!\n";
        printLine('=');
    }
