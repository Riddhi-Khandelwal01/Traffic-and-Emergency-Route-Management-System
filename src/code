            if (c == 0) return;
            if (c == 1 || c == 2) {
                int n;
                Emergency** arr = emergencyArray(n);
                if (!arr) { cout << "\n  (No emergencies recorded yet.)\n"; continue; }
                if (c == 1) sortPtrs<Emergency>(arr, n, emByseverity);
                else sortPtrs<Emergency>(arr, n, emByLocation);
                cout << "\n";
                emergencyHeader();
                for (int i = 0; i < n; i++) emergencyRow(arr[i]);
                delete[] arr;
            } else if (c == 3) {
                int n = countVehicles(false);
                if (n == 0) { cout << "\n  (No vehicles registered yet.)\n"; continue; }
                Vehicle** arr = new Vehicle*[n];
                int i = 0;
                for (Vehicle* v = vHead; v; v = v->next) arr[i++] = v;
                sortPtrs<Vehicle>(arr, n, vehByType);
                cout << "\n";
                vehicleHeader();
                for (i = 0; i < n; i++) vehicleRow(arr[i]);
                delete[] arr;
            } else {
                int n = countHospitals();
                if (n == 0) { cout << "\n  (No hospitals registered yet.)\n"; continue; }
                Hospital** arr = new Hospital*[n];
                int i = 0;
                for (Hospital* h = hHead; h; h = h->next) arr[i++] = h;
                sortPtrs<Hospital>(arr, n, hosByName);
                cout << "\n";
                hospitalHeader();
                for (i = 0; i < n; i++) hospitalRow(arr[i]);
                delete[] arr;
            }
        }
    }

