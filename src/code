    void completeEmergency() {
        bool any = false;
        for (Emergency* e = eHead; e; e = e->next) if (e->status == 1) any = true;
        if (!any) { cout << "\n  (No emergencies are currently being handled.)\n"; return; }
        cout << "\n  Emergencies currently being handled:\n\n";
        emergencyHeader();
        for (Emergency* e = eHead; e; e = e->next) if (e->status == 1) emergencyRow(e);
        cout << "\n";
        int id = readInt("Enter the ID of the emergency to mark as COMPLETED: ", 1, 1000000);
        Emergency* e = findEmergency(id);
        if (!e || e->status != 1) { cout << "  ! That emergency is not in the 'Dispatched' state.\n"; return; }
        e->status = 2;
        Vehicle* v = findVehicle(e->vehicleId);
        if (v) {
            v->available = true;
            Hospital* h = findHospital(e->hospitalId);
            v->location = h ? h->location : e->location;
            cout << "  OK: Emergency #" << id << " completed. " << vehicleTypeName(v->type) << " #" << v->id
                 << " is available again at " << graph.name(v->location) << ".\n";
        } else {
            cout << "  OK: Emergency #" << id << " marked as completed.\n";
        }
        activity.enqueue("Emergency #" + toStr(id) + " completed");
    }

    void deleteCompleted() {
        Emergency *prev = NULL, *cur = eHead;
        int removed = 0;
        while (cur) {
            if (cur->status == 2) {
                Emergency* dead = cur;
                if (prev) prev->next = cur->next; else eHead = cur->next;
                if (cur == eTail) eTail = prev;
                cur = cur->next;
                delete dead;
                removed++;
            } else {
                prev = cur;
                cur = cur->next;
            }
        }
        cout << "  OK: " << removed << " completed record(s) deleted.\n";
        if (removed > 0) activity.enqueue(toStr(removed) + " completed emergency record(s) deleted");
    }

