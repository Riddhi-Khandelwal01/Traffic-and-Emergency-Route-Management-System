    /* ======================= 7. DISPATCH ========================== */
    void dispatchNext() {
        printHeader("DISPATCH THE NEXT EMERGENCY");
        if (pq.empty()) {
            cout << "  No pending emergencies. All clear!\n";
            return;
        }
        PQItem top = pq.top();
        Emergency* e = findEmergency(top.id);
        if (!e) { pq.pop(); cout << "  ! Internal record missing; entry discarded.\n"; return; }

        int need = requiredVehicleType(e->type);
        cout << "  Highest-priority emergency in the queue:\n\n";
        emergencyHeader();
        emergencyRow(e);
        cout << "\n  Required vehicle : " << vehicleTypeName(need) << "\n";
        cout << "  Evaluating every available " << vehicleTypeName(need)
             << " using Dijkstra's algorithm...\n\n";

        cout << left << setw(5) << "ID" << setw(24) << "Currently at"
             << setw(12) << "Dist(km)" << "ETA(min)\n";
        printLine('-', 56);

        Vehicle* best = NULL;
        Route bestRoute = emptyRoute();
        int candidates = 0;
        for (Vehicle* v = vHead; v; v = v->next) {
            if (!v->available || v->type != need) continue;
            candidates++;
            Route r = graph.computeRoute(v->location, e->location);
            cout << left << setw(5) << v->id << setw(24) << fit(graph.name(v->location), 23);
            if (r.found) cout << setw(12) << r.dist << etaMinutes(r.cost) << "\n";
            else cout << "UNREACHABLE (roads blocked)\n";
            if (r.found && (best == NULL || r.cost < bestRoute.cost)) { best = v; bestRoute = r; }
        }

        if (candidates == 0) {
            cout << "\n  ! No available " << vehicleTypeName(need) << " right now.\n"
                 << "    Emergency #" << e->id << " stays in the queue. Register a vehicle (menu 4) "
                    "or complete a running mission (menu 9), then try again.\n";
            activity.enqueue("Dispatch FAILED for #" + toStr(e->id) + ": no available " + vehicleTypeName(need));
            return;
        }
        if (!best) {
            cout << "\n  ! Every available " << vehicleTypeName(need)
                 << " is cut off by blocked roads.\n"
                 << "    Re-open a road (menu 2) and try again. Emergency #" << e->id
                 << " stays in the queue.\n";
            activity.enqueue("Dispatch FAILED for #" + toStr(e->id) + ": all routes blocked");
            return;
        }

        /* choose the nearest reachable hospital (if the emergency needs one) */
        Hospital* bestH = NULL;
        Route hRoute = emptyRoute();
        if (needsHospital(e->type)) {
            for (Hospital* h = hHead; h; h = h->next) {
                Route r = graph.computeRoute(e->location, h->location);
                if (r.found && (bestH == NULL || r.cost < hRoute.cost)) { bestH = h; hRoute = r; }
            }
        }

        /* commit the dispatch */
        best->available = false;
        e->status = 1;
        e->vehicleId = best->id;
        if (bestH) e->hospitalId = bestH->id;
        pq.pop();

        cout << "\n  >>> DISPATCHED: " << vehicleTypeName(need) << " #" << best->id
             << " (from " << graph.name(best->location) << ") is the FASTEST option. <<<\n";
        cout << "\n  LEG 1 - Vehicle to the incident (" << e->locName << "):\n";
        graph.printRoute(bestRoute);

        if (needsHospital(e->type)) {
            if (bestH) {
                cout << "\n  LEG 2 - Incident to the nearest hospital (" << bestH->name << "):\n";
                graph.printRoute(hRoute);
            } else {
                cout << "\n  ! No reachable hospital found (none registered, or roads blocked). "
                        "Register a hospital in menu 5.\n";
            }
        }
        cout << "\n  Emergencies still waiting in the queue: " << pq.size() << "\n";
        activity.enqueue("Emergency #" + toStr(e->id) + " dispatched: " + vehicleTypeName(need) + " #" +
                         toStr(best->id) + " (ETA " + toStr((int)(etaMinutes(bestRoute.cost) + 0.5)) + " min)");
    }

