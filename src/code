/* ======================================================================
 *  MIN-HEAP  (used internally by Dijkstra's algorithm)
 * ====================================================================== */
struct HeapItem {
    double key;
    int node;
};

class MinHeap {
    HeapItem* data;
    int count, cap;
    MinHeap(const MinHeap&);
    MinHeap& operator=(const MinHeap&);
public:
    MinHeap() : count(0), cap(32) { data = new HeapItem[cap]; }
    ~MinHeap() { delete[] data; }
    bool empty() const { return count == 0; }

    void push(double key, int node) {
        if (count == cap) {
            HeapItem* nd = new HeapItem[cap * 2];
            for (int i = 0; i < count; i++) nd[i] = data[i];
            delete[] data;
            data = nd;
            cap *= 2;
        }
        int i = count++;
        while (i > 0) {
            int p = (i - 1) / 2;
            if (data[p].key <= key) break;
            data[i] = data[p];
            i = p;
        }
        data[i].key = key;
        data[i].node = node;
    }

    HeapItem pop() {
        HeapItem top = data[0];
        HeapItem last = data[--count];
        int i = 0;
        while (true) {
            int l = 2 * i + 1;
            if (l >= count) break;
            int r = l + 1;
            int c = (r < count && data[r].key < data[l].key) ? r : l;
            if (data[c].key >= last.key) break;
            data[i] = data[c];
            i = c;
        }
        if (count > 0) data[i] = last;
        return top;
    }
};

/* ======================================================================
 *  GRAPH  (road network)  - locations are vertices, roads are edges
 * ====================================================================== */
struct Edge {
    int to;
    double dist;      /* kilometres            */
    int traffic;      /* 1 (free) .. 5 (jam)   */
    bool blocked;
    Edge* next;
};

struct Route {
    bool found;
    double cost;      /* traffic-weighted distance */
    double dist;      /* real distance in km       */
    int len;
    int path[MAX_LOCATIONS];
};

Route emptyRoute() {
    Route r;
    r.found = false;
    r.cost = 0;
    r.dist = 0;
    r.len = 0;
    for (int i = 0; i < MAX_LOCATIONS; i++) r.path[i] = -1;
    return r;
}

class Graph {
    string names[MAX_LOCATIONS];
    Edge* adj[MAX_LOCATIONS];
    int n;
    int roads;

    Graph(const Graph&);
    Graph& operator=(const Graph&);

    void insertEdge(int u, int v, double d, int t) {
        Edge* e = new Edge;
        e->to = v;
        e->dist = d;
        e->traffic = t;
        e->blocked = false;
        e->next = adj[u];
        adj[u] = e;
    }

public:
    Graph() : n(0), roads(0) {
        for (int i = 0; i < MAX_LOCATIONS; i++) adj[i] = NULL;
    }

    ~Graph() {
        for (int i = 0; i < n; i++) {
            Edge* e = adj[i];
            while (e) {
                Edge* nx = e->next;
                delete e;
                e = nx;
            }
        }
    }

    int size() const { return n; }
    int roadCount() const { return roads; }
    const string& name(int i) const { return names[i]; }

    int findLocation(const string& nm) const {
        for (int i = 0; i < n; i++)
            if (toLower(names[i]) == toLower(nm)) return i;
        return -1;
    }

    /* returns index, -1 if full, -2 if duplicate */
    int addLocation(const string& nm) {
        if (n >= MAX_LOCATIONS) return -1;
        if (findLocation(nm) != -1) return -2;
        names[n] = nm;
        adj[n] = NULL;
        return n++;
    }

    Edge* findEdge(int u, int v) const {
        for (Edge* e = adj[u]; e; e = e->next)
            if (e->to == v) return e;
        return NULL;
    }

    void addRoad(int u, int v, double d, int t) {
        insertEdge(u, v, d, t);
        insertEdge(v, u, d, t);
        roads++;
    }

    void setTraffic(int u, int v, int level) {
        findEdge(u, v)->traffic = level;
        findEdge(v, u)->traffic = level;
    }

    void setBlocked(int u, int v, bool b) {
        findEdge(u, v)->blocked = b;
        findEdge(v, u)->blocked = b;
    }

    int degree(int u) const {
        int c = 0;
        for (Edge* e = adj[u]; e; e = e->next) c++;
        return c;
    }

    /* the k-th road (1-based) in the same order used by displayRoads() */
    bool roadAt(int index, int& a, int& b) const {
        int idx = 0;
        for (int u = 0; u < n; u++)
            for (Edge* e = adj[u]; e; e = e->next) {
                if (u > e->to) continue;
                idx++;
                if (idx == index) { a = u; b = e->to; return true; }
            }
        return false;
    }

    void displayLocations() const {
        cout << left << setw(5) << "No." << setw(24) << "Location" << "Roads\n";
        printLine('-', 36);
        for (int i = 0; i < n; i++)
            cout << setw(5) << (i + 1) << setw(24) << fit(names[i], 23) << degree(i) << "\n";
    }

    /* mode 0 = all roads, mode 1 = only blocked / heavily congested roads */
    int displayRoads(int mode) const {
        int idx = 0, shown = 0;
        cout << left << setw(5) << "No." << setw(21) << "From" << setw(21) << "To"
             << setw(10) << "Dist(km)" << setw(16) << "Traffic" << "Status\n";
        printLine('-', 78);
        for (int u = 0; u < n; u++)
            for (Edge* e = adj[u]; e; e = e->next) {
                if (u > e->to) continue;
                idx++;
                bool problem = e->blocked || e->traffic >= 4;
                if (mode == 1 && !problem) continue;
                cout << setw(5) << idx
                     << setw(21) << fit(names[u], 20)
                     << setw(21) << fit(names[e->to], 20)
                     << setw(10) << e->dist
                     << setw(16) << (toStr(e->traffic) + " - " + trafficName(e->traffic))
                     << (e->blocked ? "BLOCKED" : "Open") << "\n";
                shown++;
            }
        return shown;
    }

    void displayNeighbours(int u) const {
        for (Edge* e = adj[u]; e; e = e->next)
            cout << "     -> " << setw(22) << fit(names[e->to], 21) << e->dist << " km, "
                 << trafficName(e->traffic) << (e->blocked ? " [BLOCKED]" : "") << "\n";
    }

    /* Dijkstra's shortest-path algorithm (blocked roads are skipped,
       edge weight = distance x traffic factor) */
    void dijkstra(int src, double cost[], int prev[]) const {
        for (int i = 0; i < n; i++) { cost[i] = INF; prev[i] = -1; }
        cost[src] = 0;
        MinHeap h;
        h.push(0, src);
        while (!h.empty()) {
            HeapItem top = h.pop();
            int u = top.node;
            if (top.key > cost[u]) continue;           /* stale entry */
            for (Edge* e = adj[u]; e; e = e->next) {
                if (e->blocked) continue;
                double w = e->dist * trafficFactor(e->traffic);
                if (cost[u] + w < cost[e->to]) {
                    cost[e->to] = cost[u] + w;
                    prev[e->to] = u;
                    h.push(cost[e->to], e->to);
                }
            }
        }
    }

    Route computeRoute(int src, int dest) const {
        Route r = emptyRoute();
        double cost[MAX_LOCATIONS];
        int prev[MAX_LOCATIONS];
        dijkstra(src, cost, prev);
        if (cost[dest] >= INF) return r;

        int tmp[MAX_LOCATIONS];
        int k = 0;
        for (int v = dest; v != -1; v = prev[v]) tmp[k++] = v;
        r.len = k;
        for (int i = 0; i < k; i++) r.path[i] = tmp[k - 1 - i];
        r.cost = cost[dest];
        r.dist = 0;
        for (int i = 0; i + 1 < k; i++) r.dist += findEdge(r.path[i], r.path[i + 1])->dist;
        r.found = true;
        return r;
    }

    void printRoute(const Route& r) const {
        if (!r.found) {
            cout << "  ** NO ROUTE AVAILABLE - the destination is cut off by blocked roads. **\n";
            return;
        }
        cout << "  Path : ";
        for (int i = 0; i < r.len; i++) {
            cout << names[r.path[i]];
            if (i + 1 < r.len) cout << " -> ";
        }
        cout << "\n";
        if (r.len == 1) {
            cout << "  (Already at the destination - no travel needed)\n";
            return;
        }
        cout << "  Segments:\n";
        for (int i = 0; i + 1 < r.len; i++) {
            Edge* e = findEdge(r.path[i], r.path[i + 1]);
            cout << "     " << (i + 1) << ". " << fit(names[r.path[i]], 20) << " -> "
                 << fit(names[r.path[i + 1]], 20) << " : " << e->dist << " km, "
                 << trafficName(e->traffic) << " traffic\n";
        }
        cout << "  Total road distance            : " << r.dist << " km\n";
        cout << "  Traffic-weighted distance      : " << r.cost << " km\n";
        cout << "  Estimated travel time (ETA)    : " << etaMinutes(r.cost) << " minutes\n";
    }
};

/* ======================================================================
 *  LINKED-LIST RECORDS
 * ====================================================================== */
struct Vehicle {
    int id;
    int type;          /* 1 Ambulance, 2 Fire Truck, 3 Police Car */
    int location;
    bool available;
    Vehicle* next;
};

struct Hospital {
    int id;
    string name;
    int location;
    Hospital* next;
};

struct Emergency {
    int id;
    int location;
    string locName;
    int type;          /* 1 Accident, 2 Medical, 3 Fire, 4 Crime/Other */
    int severity;      /* 1 (minor) .. 5 (life-threatening) */
    int status;        /* 0 Pending, 1 Dispatched, 2 Completed */
    int vehicleId;
    int hospitalId;
    int seq;           /* arrival order, used to break priority ties */
    Emergency* next;
};

/*
 *  PRIORITY QUEUE (binary max-heap): highest severity first,
 *  earlier arrival first when severities are equal.
*/
struct PQItem {
    int id;
    int severity;
    int seq;
};

class EmergencyPQ {
    PQItem a[MAX_PENDING];
    int n;
    static bool before(const PQItem& x, const PQItem& y) {
        if (x.severity != y.severity) return x.severity > y.severity;
        return x.seq < y.seq;
    }
public:
    EmergencyPQ() : n(0) {
        for (int i = 0; i < MAX_PENDING; i++) { a[i].id = 0; a[i].severity = 0; a[i].seq = 0; }
    }
    bool empty() const { return n == 0; }
    bool full() const { return n >= MAX_PENDING; }
    int size() const { return n; }
    PQItem top() const { return a[0]; }

    void push(const PQItem& it) {
        int i = n++;
        while (i > 0) {
            int p = (i - 1) / 2;
            if (!before(it, a[p])) break;
            a[i] = a[p];
            i = p;
        }
        a[i] = it;
    }

    void pop() {
        PQItem last = a[--n];
        int i = 0;
        while (true) {
            int l = 2 * i + 1;
            if (l >= n) break;
            int r = l + 1;
            int c = (r < n && before(a[r], a[l])) ? r : l;
            if (!before(a[c], last)) break;
            a[i] = a[c];
            i = c;
        }
        if (n > 0) a[i] = last;
    }
};

/* ======================================================================
 *  QUEUE (circular array): the most recent system activities (FIFO)
 * ====================================================================== */
class ActivityLog {
    string items[LOG_CAPACITY];
    int front, count, counter;
public:
    ActivityLog() : front(0), count(0), counter(0) {}

    void enqueue(const string& msg) {
        if (count == LOG_CAPACITY) {              /* full: drop the oldest */
            front = (front + 1) % LOG_CAPACITY;
            count--;
        }
        counter++;
        items[(front + count) % LOG_CAPACITY] = "#" + toStr(counter) + "  " + msg;
        count++;
    }

    void display() const {
        if (count == 0) { cout << "  (No activity recorded yet.)\n"; return; }
        cout << "  Showing the last " << count << " event(s), oldest first:\n\n";
        for (int i = 0; i < count; i++)
            cout << "  " << items[(front + i) % LOG_CAPACITY] << "\n";
    }
};

/* generic insertion sort on an array of pointers (stable) */
template <typename T>
void sortPtrs(T** arr, int n, bool (*before)(const T*, const T*)) {
    for (int i = 1; i < n; i++) {
        T* key = arr[i];
        int j = i - 1;
        while (j >= 0 && before(key, arr[j])) {
            arr[j + 1] = arr[j];
            j--;
        }
        arr[j + 1] = key;
    }
}

bool emByseverity(const Emergency* a, const Emergency* b) {
    if (a->severity != b->severity) return a->severity > b->severity;
    return a->id < b->id;
}
bool emByLocation(const Emergency* a, const Emergency* b) {
    string x = toLower(a->locName), y = toLower(b->locName);
    if (x != y) return x < y;
    return a->id < b->id;
}
bool vehByType(const Vehicle* a, const Vehicle* b) {
    if (a->type != b->type) return a->type < b->type;
    return a->id < b->id;
}
bool hosByName(const Hospital* a, const Hospital* b) {
    return toLower(a->name) < toLower(b->name);
}

